--!nocheck
local T = require("./runner/T")
local L = require("./runner/Loader")
L.reset()
local Release = L.require(L.Shared.Config.ReleasePreset)
local Config = L.require(L.Shared.DeveloperConsole.Config)
local Game = L.require(L.Shared.Config.GameConfig)
local WC = L.require(L.Shared.Config.WeaponConfig)
local WS = L.require(L.Shared.Weapons.WeaponState)
local Trigger = L.require(L.Shared.DeveloperConsole.AutoFire)
local Access = L.require(L.Server.Services.DeveloperAccess)
local Profile = L.require(L.Shared.Progression.Profile)
T.describe("Approved public Mobile promotion", function()
	T.it("uses validated Mobile revision 3 with the owner's ten-shell clarification", function()
		assert(Release.name == "Mobile" and Release.revision == 3 and Release.scope == "all")
		T.expect(Config.validate(Release.values)).toEqual(Release.values)
	end)
	T.it("recognizes production exclusively", function()
		assert(Release.isProduction(10772275012, 82505574993280))
		assert(not Release.isProduction(10772492892, 139437092998076))
		assert(not Release.isProduction(10772275012, 139437092998076))
	end)
	T.it("applies server and client movement through shared config", function()
		assert(Game.Movement.WalkSpeed == 28.5 and Game.Movement.JumpHeight == 14)
		assert(Game.Movement.AirControl == 0.64 and Game.Movement.CrouchSpeed == 11)
		assert(Game.Movement.SprintEnabled == false)
	end)
	T.it("applies approved damage range reload spread and ammunition", function()
		assert(WC.Damage.PelletDamage == 17 and WC.Damage.MaxRange == 214)
		assert(WC.Ammo.MagazineSize == 10 and WC.Timing.ReloadInsertTime == 0.27)
		T.expect(WC.Spread.Pattern[2].radius).toBeNear(1.6 * 0.4)
		assert(WC.Recoil.RecoverTime == 0.12)
	end)
	T.it("preserves double-pump authoritative timing", function()
		assert(WC.Timing.FireCooldown == 1 and WC.Timing.MinShotInterval == 0.4)
		assert(WC.Timing.SwapTime == 0.15 and WC.Timing.EquipTime == 0.35)
		local s = WS.new(WS.rulesFromConfig(WC), -1)
		assert(WS.fire(s, 1, 0))
		assert(WS.equip(s, 2, 0.01))
		assert(not WS.fire(s, 2, 0.399))
		assert(WS.fire(s, 2, 0.4))
	end)
	T.it("touch trigger is immediate and automatic swap remains legal", function()
		local c = Release.values.autoFire
		local trigger = Trigger.new()
		assert(Trigger.step(trigger, c, 1, "target", "Touch", true, true, false))
		assert(not Trigger.step(trigger, c, 1.01, "target", "Touch", true, true, false))
		local s = WS.new(WS.rulesFromConfig(WC), -1)
		assert(WS.fire(s, 1, 1))
		assert(Trigger.swapSlot(c, s, 1.01) == 2)
		assert(WS.equip(s, 2, 1.01))
		assert(not WS.fire(s, 2, 1.16))
		assert(WS.fire(s, 2, 1.4))
	end)
	T.it("mouse assistance and trigger are disabled", function()
		assert(Release.values.aiming.mouseEligible == false)
		assert(Release.values.autoFire.mouseEligible == false)
		assert(not Trigger.step(Trigger.new(), Release.values.autoFire, 0, "target", "Keyboard", true, true, false))
	end)
	T.it("never grants public developer access even to the owner", function()
		assert(not Access.allowed(11808586604, 10772275012, 82505574993280))
		assert(not Access.allowed(11808586604, 10772492892, 139437092998076))
	end)
	T.it("new public profiles retain earned-only cosmetic ownership", function()
		local p = Profile.new(0)
		assert(p.owned.Default == true)
		local n = 0
		for _ in p.owned do
			n += 1
		end
		assert(n == 1)
	end)
end)
