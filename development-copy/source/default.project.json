{
  "name": "double-pump-development",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$path": "assets",
        "$ignoreUnknownInstances": true
      },
      "FeedbackClient": {
        "$path": "feedback/client"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "DevelopmentIdentity": {
        "$path": "../overrides/DevelopmentIdentity.luau"
      },
      "DevelopmentSkins": {
        "$path": "../overrides/DevelopmentSkins.server.luau"
      },
      "FeedbackBackend": {
        "$path": "feedback/backend"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "DevelopmentSkinReady": {
          "$path": "../overrides/DevelopmentSkinReady.client.luau"
        },
        "Feedback": {
          "$path": "feedback/Feedback.client.luau"
        }
      },
      "StarterCharacterScripts": {
        "$ignoreUnknownInstances": true,
        "Health": {
          "$path": "src/character/Health.server.luau"
        }
      },
      "$properties": {
        "CharacterJumpHeight": 7.6,
        "CharacterUseJumpPower": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -120,
        "Gravity": 196.2,
        "StreamingEnabled": false
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true
      }
    }
  }
}
