--!nocheck
local T = require("./runner/T")
local Loader = require("./runner/Loader")
local Q = Loader.require(Loader.Shared.Match.LobbyQueue)
local Rules = Loader.require(Loader.Shared.Match.MatchRules)
local Config = Loader.require(Loader.Shared.Config.GameConfig)
local V, CF = Loader.roblox.Vector3, Loader.roblox.CFrame
local expect, it = T.expect, T.it
local function queue()
	return Q.new(Config.LobbyQueue)
end

T.describe("Voluntary lobby queue", function()
	it("waits indefinitely empty", function()
		local q = queue()
		for n = 1, 20 do
			local selected, state = Q.step(q, {}, n * 100, true)
			expect(#selected).toBe(0)
			expect(state).toBe("Waiting")
		end
	end)
	it("one occupant never starts a countdown", function()
		local q = queue()
		Q.step(q, { 1 }, 0, true)
		local selected, state = Q.step(q, { 1 }, 2000, true)
		expect(state).toBe("Waiting")
		expect(q.deadline).toBe(nil)
		expect(#selected).toBe(0)
	end)
	it("starts an exact fifteen second countdown with two", function()
		local q = queue()
		local _, state = Q.step(q, { 1, 2 }, 10, true)
		expect(state).toBe("Countdown")
		expect(q.deadline).toBe(25)
		expect(#Q.step(q, { 1, 2 }, 24.999, true)).toBe(0)
		expect(Q.step(q, { 1, 2 }, 25, true)).toEqual({ 1, 2 })
	end)
	it("deduplicates both fresh and retained occupants", function()
		local q = queue()
		Q.step(q, { 1, 1, 2, 2 }, 0, true)
		Q.step(q, { 2, 2, 1, 1 }, 1, true)
		expect(q.order).toEqual({ 1, 2 })
	end)
	it("a departure cancels immediately below minimum", function()
		local q = queue()
		Q.step(q, { 1, 2 }, 0, true)
		local selected, state = Q.step(q, { 1 }, 14.99, true)
		expect(state).toBe("Waiting")
		expect(q.deadline).toBe(nil)
		expect(#selected).toBe(0)
	end)
	it("reentry starts a fresh countdown", function()
		local q = queue()
		Q.step(q, { 1, 2 }, 0, true)
		Q.step(q, { 1 }, 14, true)
		Q.step(q, { 1, 2 }, 15, true)
		expect(q.deadline).toBe(30)
	end)
	it("new occupants do not restart an ongoing countdown", function()
		local q = queue()
		Q.step(q, { 1, 2 }, 0, true)
		Q.step(q, { 1, 2, 3 }, 8, true)
		expect(q.deadline).toBe(15)
		expect(Q.step(q, { 1, 2, 3 }, 15, true)).toEqual({ 1, 2, 3 })
	end)
	it("continues above the minimum after a departure", function()
		local q = queue()
		Q.step(q, { 1, 2, 3 }, 0, true)
		Q.step(q, { 1, 3 }, 10, true)
		expect(q.deadline).toBe(15)
		expect(Q.step(q, { 1, 3 }, 15, true)).toEqual({ 1, 3 })
	end)
	it("uses final membership rather than stale countdown occupants", function()
		local q = queue()
		Q.step(q, { 1, 2, 3 }, 0, true)
		expect(Q.step(q, { 2, 3, 4 }, 15, true)).toEqual({ 2, 3, 4 })
	end)
	it("never admits a player who disconnects at the deadline", function()
		local q = queue()
		Q.step(q, { 1, 2 }, 0, true)
		expect(#Q.step(q, { 1 }, 15, true)).toBe(0)
		expect(q.order).toEqual({ 1 })
	end)
	it("caps admission at ten and retains FIFO overflow", function()
		local q = queue()
		local occupants = {}
		for i = 1, 12 do
			table.insert(occupants, i)
		end
		Q.step(q, occupants, 0, true)
		local selected = Q.step(q, occupants, 15, true)
		expect(#selected).toBe(10)
		expect(selected[1]).toBe(1)
		expect(selected[10]).toBe(10)
		expect(q.order).toEqual({ 11, 12 })
	end)
	it("reentering goes behind players already waiting", function()
		local q = queue()
		Q.step(q, { 1, 2, 3 }, 0, false)
		Q.step(q, { 2, 3 }, 1, false)
		Q.step(q, { 1, 2, 3 }, 2, false)
		expect(q.order).toEqual({ 2, 3, 1 })
	end)
	it("accepts waiting occupants while arena is busy without admission", function()
		local q = queue()
		local selected, state = Q.step(q, { 1, 2, 3 }, 0, false)
		expect(state).toBe("Pending")
		expect(#selected).toBe(0)
		Q.step(q, { 1, 2, 3 }, 1000, false)
		expect(q.deadline).toBe(nil)
		Q.step(q, { 1, 2, 3 }, 1001, true)
		expect(q.deadline).toBe(1016)
	end)
	it("a busy arena cancels a previously running countdown", function()
		local q = queue()
		Q.step(q, { 1, 2 }, 0, true)
		expect(#Q.step(q, { 1, 2 }, 15, false)).toBe(0)
		expect(q.deadline).toBe(nil)
	end)
	it("selects only once even when stepped at the same deadline", function()
		local q = queue()
		Q.step(q, { 1, 2 }, 0, true)
		expect(#Q.step(q, { 1, 2 }, 15, true)).toBe(2)
		expect(#Q.step(q, {}, 15, false)).toBe(0)
	end)
	it("root-center spatial test excludes outside and elevated points", function()
		local cf, size = CF.new(10, 5, 10), V.new(10, 10, 10)
		expect(Q.contains(cf, size, V.new(10, 5, 10))).toBe(true)
		expect(Q.contains(cf, size, V.new(15, 5, 10))).toBe(true)
		expect(Q.contains(cf, size, V.new(15.01, 5, 10))).toBe(false)
		expect(Q.contains(cf, size, V.new(10, 10.01, 10))).toBe(false)
	end)
	it("spatial test respects oriented bounds", function()
		local cf = CF.new(10, 5, 10) * CF.Angles(0, math.pi / 4, 0)
		expect(Q.contains(cf, V.new(4, 6, 12), cf:PointToWorldSpace(V.new(1, 0, 5)))).toBe(true)
		expect(Q.contains(cf, V.new(4, 6, 12), cf:PointToWorldSpace(V.new(3, 0, 0)))).toBe(false)
	end)
	it("all existing range spawns remain outside the queue", function()
		local range = Loader.require(Loader.Server.Maps.Range)
		local model = range.build()
		local cf = CF.new(range.origin + Config.LobbyQueue.Offset)
		for _, marker in model:FindFirstChild("Markers"):GetChildren() do
			if marker.Name == "Spawn" then
				expect(Q.contains(cf, Config.LobbyQueue.Size, marker.CFrame.Position + V.new(0, 3, 0))).toBe(false)
			end
		end
	end)
	it("server population alone cannot start the production state machine", function()
		local m = Rules.new(Config.Match)
		for _ = 1, 100 do
			Rules.step(m, 10, { players = 10, voluntary = true, admitted = false })
		end
		expect(m.state).toBe("Waiting")
	end)
	it("admission votes before starting and requires two players", function()
		local m = Rules.new(Config.Match)
		Rules.step(m, 0, { players = 1, voluntary = true, admitted = true })
		expect(m.state).toBe("Waiting")
		Rules.step(m, 0, { players = 2, voluntary = true, admitted = true })
		expect(m.state).toBe("Voting")
		Rules.step(m, Config.Match.VotingTime, { players = 2, voluntary = true })
		expect(m.state).toBe("Starting")
		Rules.step(m, Config.Match.StartingCountdown, { players = 2, voluntary = true })
		expect(m.state).toBe("Active")
	end)
	it("results return to Waiting instead of automatically starting another match", function()
		local m = Rules.new(Config.Match)
		m.state = "Results"
		m.timeLeft = 1
		Rules.step(m, 1, { players = 10, voluntary = true })
		expect(m.state).toBe("Waiting")
		Rules.step(m, 100, { players = 10, voluntary = true })
		expect(m.state).toBe("Waiting")
	end)
	it("loss of roster before arena start aborts safely", function()
		local m = Rules.new(Config.Match)
		m.state = "Voting"
		m.timeLeft = 1
		Rules.step(m, 1, { players = 1, voluntary = true })
		expect(m.state).toBe("Waiting")
	end)
end)
