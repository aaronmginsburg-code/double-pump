--!nocheck
local T = require("./runner/T")
local L = require("./runner/Loader")
L.reset()
local C = L.require(L.Shared.Audio.LobbyCues)
T.describe("Server-driven lobby audio decisions", function()
	T.it("initial outside snapshot and idle polls are silent", function()
		local s = C.new()
		T.expect(C.step(s, false, "Waiting", 0, 0, false)).toBe(nil)
		T.expect(C.step(s, false, "Pending", 0, 200, false)).toBe(nil)
	end)
	T.it("entry and deliberate exit emit once each", function()
		local s = C.new()
		T.expect(C.step(s, true, "Waiting", 0, 0, false)).toBe("QueueJoin")
		T.expect(C.step(s, true, "Waiting", 0, 0.1, false)).toBe(nil)
		T.expect(C.step(s, false, "Waiting", 0, 1.1, false)).toBe("QueueLeave")
	end)
	T.it("boundary chatter is suppressed without changing membership", function()
		local s = C.new()
		C.step(s, true, "Waiting", 0, 0, false)
		T.expect(C.step(s, false, "Waiting", 0, 0.1, false)).toBe(nil)
		T.expect(s.queued).toBe(false)
		T.expect(C.step(s, true, "Waiting", 0, 0.2, false)).toBe(nil)
		T.expect(s.queued).toBe(true)
	end)
	T.it("new membership takes priority over simultaneous countdown tick", function()
		local s = C.new()
		T.expect(C.step(s, true, "Countdown", 15, 0, false)).toBe("QueueJoin")
		T.expect(C.step(s, true, "Countdown", 15, 0.1, false)).toBe(nil)
		T.expect(C.step(s, true, "Countdown", 14, 1, false)).toBe("QueueCountdown")
	end)
	T.it("countdown ticks once per remaining second and stops in pending", function()
		local s = C.new()
		C.step(s, true, "Waiting", 0, 0, false)
		T.expect(C.step(s, true, "Countdown", 15, 1, false)).toBe("QueueCountdown")
		T.expect(C.step(s, true, "Countdown", 15, 1.1, false)).toBe(nil)
		T.expect(C.step(s, true, "Pending", 0, 2, false)).toBe(nil)
		T.expect(C.step(s, true, "Pending", 0, 3, false)).toBe(nil)
	end)
	T.it("cancellation only reaches the remaining queued player", function()
		local a, b = C.new(), C.new()
		C.step(a, true, "Countdown", 15, 0, false)
		C.step(b, true, "Countdown", 15, 0, false)
		T.expect(C.step(a, true, "Waiting", 0, 2, false)).toBe("QueueCancel")
		T.expect(C.step(b, false, "Waiting", 0, 2, false)).toBe("QueueLeave")
		T.expect(C.step(a, true, "Waiting", 0, 2.1, false)).toBe(nil)
	end)
	T.it("selected players never get a false leave or cancel", function()
		local s = C.new()
		C.step(s, true, "Countdown", 1, 0, false)
		T.expect(C.step(s, false, "Admitting", 0, 2, true)).toBe(nil)
		T.expect(C.step(s, false, "Pending", 0, 2.1, false)).toBe(nil)
	end)
	T.it("rejects malformed, unapproved or replayed remote cues", function()
		for _, data in
			{
				false,
				{},
				{ serial = 1, cue = "Fire" },
				{ serial = 0, cue = "QueueJoin" },
				{ serial = 1.5, cue = "QueueJoin" },
				{ serial = math.huge, cue = "QueueJoin" },
				{ serial = 0 / 0, cue = "QueueJoin" },
			}
		do
			local serial, cue = C.accept(0, data)
			T.expect(serial).toBe(0)
			T.expect(cue).toBe(nil)
		end
		local serial, cue = C.accept(0, { serial = 1, cue = "QueueJoin" })
		T.expect(serial).toBe(1)
		T.expect(cue).toBe("QueueJoin")
		local same, replay = C.accept(serial, { serial = 1, cue = "QueueJoin" })
		T.expect(same).toBe(1)
		T.expect(replay).toBe(nil)
	end)
	T.it("accepts each valid lobby cue without any gameplay action", function()
		for _, cue in { "QueueJoin", "QueueLeave", "QueueCountdown", "QueueCancel", "Admitted", "ReturnToRange" } do
			local _, actual = C.accept(0, { serial = 1, cue = cue })
			T.expect(actual).toBe(cue)
		end
	end)
	T.it("mastery tier crossing chooses one prestige cue above level-up", function()
		T.expect(C.rewardCue({ masteryBefore = 0, masteryAfter = 1, levelBefore = 1, levelAfter = 2 }))
			.toBe("MasteryMilestone")
		T.expect(C.rewardCue({ masteryBefore = 1, masteryAfter = 3 })).toBe("MasteryMilestone")
	end)
	T.it("ordinary level and reward paths remain distinct", function()
		T.expect(C.rewardCue({ masteryBefore = 1, masteryAfter = 1, levelBefore = 1, levelAfter = 2 })).toBe("LevelUp")
		T.expect(C.rewardCue({ masteryBefore = 1, masteryAfter = 1, levelBefore = 2, levelAfter = 2 })).toBe("Reward")
		T.expect(C.rewardCue({})).toBe("Reward")
	end)
end)
L.reset()
