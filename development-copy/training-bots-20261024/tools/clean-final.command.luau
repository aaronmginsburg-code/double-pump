assert(not game.RunService:IsRunning());assert(game.GameId==10772492892 and game.PlaceId==139437092998076);local packet=game.HttpService:JSONDecode([====[[{"path": "ServerScriptService.Server.Services.CombatContext", "source": "--!strict\n-- Server-owned participation, independent of client-supplied attributes/remotes.\n-- Attributes only mirror this table for client raycast prediction.\nlocal Players = game:GetService(\"Players\")\n\nlocal Actors = require(script.Parent.Participants)\nlocal Policy = require(game:GetService(\"ReplicatedStorage\").Shared.Training.Policy)\nlocal training: { [Player]: boolean } = {}\nlocal CombatContext = {}\ntype Entry = { kind: string, matchId: number }\nlocal entries: { [Player]: Entry } = {}\nlocal activeMatch: number? = nil\n\nfunction CombatContext.set(player: Player, kind: string, matchId: number?)\n\tentries[player] = { kind = kind, matchId = matchId or 0 }\n\tlocal character = Actors.character(player)\n\tif character then\n\t\tcharacter:SetAttribute(\"CombatContext\", kind)\n\t\tcharacter:SetAttribute(\"CombatMatchId\", matchId or 0)\n\tend\nend\n\nfunction CombatContext.refresh(player: Player)\n\tlocal entry = entries[player]\n\tif entry then\n\t\tCombatContext.set(player, entry.kind, entry.matchId)\n\tend\nend\n\nfunction CombatContext.activate(matchId: number?)\n\tactiveMatch = matchId\nend\n\nfunction CombatContext.forget(player: Player)\n\tentries[player] = nil\n\ttraining[player] = nil\nend\n\nfunction CombatContext.resolve(attacker: Player, target: Model): string\n\tlocal a = entries[attacker]\n\tlocal shooter = Actors.character(attacker)\n\tif not a or not shooter or shooter == target then\n\t\treturn \"Blocked\"\n\tend\n\tif target:GetAttribute(\"Dummy\") == true then\n\t\treturn if a.kind == \"Lobby\" then \"Dummy\" else \"Blocked\"\n\tend\n\tlocal victim = Actors.fromModel(target)\n\tlocal b = victim and entries[victim]\n\tif not victim or Actors.character(victim) ~= target or not b then\n\t\treturn \"Blocked\"\n\tend\n\tif a.kind == \"Lobby\" and b.kind == \"Lobby\" then\n\t\tlocal owner = Actors.owner()\n\t\tif Actors.isBot(attacker) or Actors.isBot(victim) then\n\t\t\treturn if owner\n\t\t\t\t\tand Policy.lobbyAllowed(attacker, victim, owner, Actors.list(), training[owner] == true)\n\t\t\t\tthen \"Training\"\n\t\t\t\telse \"Blocked\"\n\t\tend\n\t\treturn \"Practice\"\n\tend\n\tif a.kind == \"Match\" and b.kind == \"Match\" and a.matchId == activeMatch and b.matchId == activeMatch then\n\t\tlocal at = if Actors.isBot(attacker) then attacker.team else (attacker.Team and attacker.Team.Name)\n\t\tlocal bt = if Actors.isBot(victim) then victim.team else (victim.Team and victim.Team.Name)\n\t\tif at and bt and at ~= bt then\n\t\t\treturn \"Match\"\n\t\tend\n\tend\n\treturn \"Blocked\"\nend\n\nfunction CombatContext.beginTraining(attacker: any, target: Model)\n\tlocal bot = Actors.fromModel(target)\n\tif Actors.isBot(bot) and bot.owner == attacker and CombatContext.resolve(attacker, target) == \"Training\" then\n\t\ttraining[attacker] = true\n\tend\nend\nfunction CombatContext.stopTraining(owner: Player)\n\ttraining[owner] = nil\nend\nfunction CombatContext.trainingActive(owner: Player): boolean\n\treturn training[owner] == true\nend\nreturn CombatContext\n"}, {"path": "StarterPlayer.StarterPlayerScripts.Client.UI.Postgame", "source": "--!strict\n-- End of match: the result (victory / defeat / draw), MVP, the full scoreboard and your\n-- rewards; then map voting with live vote counts.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal GuiService = game:GetService(\"GuiService\")\n\nlocal Shared = ReplicatedStorage.Shared\nlocal Net = require(Shared.Net)\nlocal AssetIds = require(Shared.Config.AssetIds)\nlocal Levels = require(Shared.Progression.Levels)\n\nlocal Theme = require(script.Parent.Theme)\nlocal UIRoot = require(script.Parent.UIRoot)\nlocal Controllers = script.Parent.Parent.Controllers\nlocal MatchClient = require(Controllers.MatchClient)\nlocal ProfileClient = require(Controllers.ProfileClient)\nlocal AudioController = require(Controllers.AudioController)\nlocal InputController = require(Controllers.InputController)\n\nlocal LobbyCues = require(game:GetService(\"ReplicatedStorage\").Shared.Audio.LobbyCues)\n\nlocal Postgame = {}\n\nlocal player = Players.LocalPlayer\nlocal C = Theme.Colors\nlocal new = Theme.new\n\nlocal gui: ScreenGui\nlocal root: Frame\nlocal resultsFrame: Frame\nlocal votingFrame: Frame\nlocal rewardPanel: Frame\nlocal voteCards: { [string]: { frame: TextButton, count: TextLabel, stroke: UIStroke } } = {}\nlocal myVote: string? = nil\nlocal votingEndsAt = 0\nlocal votingTimer: TextLabel\n\n-- Fallback card colours when map art hasn't been uploaded yet.\nlocal MAP_COLORS: { [string]: { Color3 } } = {\n\tWarehouse = { Color3.fromRGB(70, 82, 100), Color3.fromRGB(26, 30, 40) },\n\tDustTown = { Color3.fromRGB(214, 160, 96), Color3.fromRGB(110, 70, 40) },\n\tRooftops = { Color3.fromRGB(90, 120, 200), Color3.fromRGB(30, 30, 70) },\n}\n\nlocal function clear(frame: Instance)\n\tfor _, child in frame:GetChildren() do\n\t\tif child:IsA(\"GuiObject\") then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\nend\n\nlocal function hideAll()\n\tresultsFrame.Visible = false\n\tvotingFrame.Visible = false\nend\n\nfunction Postgame.hide()\n\tgui.Enabled = false\n\thideAll()\nend\n\n---------------------------------------------------------------------------------------\n-- Results\n\nlocal function showResults(data: any)\n\tgui.Enabled = true\n\thideAll()\n\tresultsFrame.Visible = true\n\tclear(resultsFrame)\n\n\tlocal myTeam = MatchClient.myTeam()\n\tlocal winner = data.winner\n\tlocal headline, color\n\tif winner == nil or winner == \"\" then\n\t\theadline, color = \"DRAW\", C.Text\n\telseif myTeam == nil then\n\t\theadline, color = `{string.upper(winner)} WINS`, Theme.teamColor(winner)\n\telseif winner == myTeam then\n\t\theadline, color = \"VICTORY\", C.Gold\n\telse\n\t\theadline, color = \"DEFEAT\", C.Hot\n\tend\n\tif myTeam then\n\t\tAudioController.play(\n\t\t\tif headline == \"VICTORY\" then \"Victory\" elseif headline == \"DEFEAT\" then \"Defeat\" else \"MatchEnd\"\n\t\t)\n\telse\n\t\tAudioController.play(\"MatchEnd\")\n\tend\n\n\tlocal title = Theme.label({\n\t\tText = headline,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 40),\n\t\tSize = UDim2.fromOffset(900, 120),\n\t\tTextColor3 = color,\n\t\tFontFace = Theme.Fonts.Display,\n\t\tOutline = 4,\n\t\tParent = resultsFrame,\n\t})\n\tlocal scale = new(\"UIScale\", { Scale = 1.6, Parent = title }) :: UIScale\n\tTheme.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)\n\tlocal scores = data.scores or {}\n\tTheme.label({\n\t\tText = `<font color=\"#{Theme.teamColor(\"Red\"):ToHex()}\">{scores.Red or 0}</font>  \u2013  <font color=\"#{Theme\n\t\t\t.teamColor(\"Blue\")\n\t\t\t:ToHex()}\">{scores.Blue or 0}</font>`,\n\t\tRichText = true,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 160),\n\t\tSize = UDim2.fromOffset(400, 56),\n\t\tFontFace = Theme.Fonts.Display,\n\t\tParent = resultsFrame,\n\t})\n\tlocal reasonText = if data.reason == \"Draw\"\n\t\tthen \"Still tied after overtime\"\n\t\telseif data.reason == \"Overtime\" then \"Decided in overtime\"\n\t\telseif data.reason == \"NotEnoughPlayers\" then \"Ended early: not enough players\"\n\t\telse nil\n\tif reasonText then\n\t\tTheme.label({\n\t\t\tText = reasonText,\n\t\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\t\tPosition = UDim2.new(0.5, 0, 0, 216),\n\t\t\tSize = UDim2.fromOffset(500, 26),\n\t\t\tTextColor3 = C.TextDim,\n\t\t\tFontFace = Theme.Fonts.Bold,\n\t\t\tParent = resultsFrame,\n\t\t})\n\tend\n\n\t-- MVP card\n\tlocal mvpCard = Theme.panel({\n\t\tPosition = UDim2.fromOffset(120, 270),\n\t\tSize = UDim2.fromOffset(380, 300),\n\t\tParent = resultsFrame,\n\t})\n\tTheme.label({\n\t\tText = \"MVP\",\n\t\tSize = UDim2.new(1, 0, 0, 46),\n\t\tPosition = UDim2.fromOffset(0, 18),\n\t\tTextColor3 = C.Gold,\n\t\tFontFace = Theme.Fonts.Display,\n\t\tParent = mvpCard,\n\t})\n\tif data.mvp then\n\t\tlocal thumb = new(\"ImageLabel\", {\n\t\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\t\tPosition = UDim2.new(0.5, 0, 0, 72),\n\t\t\tSize = UDim2.fromOffset(130, 130),\n\t\t\tBackgroundColor3 = Theme.teamColor(data.mvp.team),\n\t\t\tImage = \"\",\n\t\t\tParent = mvpCard,\n\t\t}, { Theme.corner(65) })\n\t\tif data.mvp.botId then\n\t\t\tTheme.label({\n\t\t\t\tText = \"BOT\",\n\t\t\t\tSize = UDim2.fromScale(1, 1),\n\t\t\t\tFontFace = Theme.Fonts.Heavy,\n\t\t\t\tTextSize = 30,\n\t\t\t\tParent = thumb,\n\t\t\t})\n\t\telse\n\t\t\ttask.spawn(function()\n\t\t\t\tlocal ok, image = pcall(function()\n\t\t\t\t\treturn Players:GetUserThumbnailAsync(\n\t\t\t\t\t\tdata.mvp.userId,\n\t\t\t\t\t\tEnum.ThumbnailType.HeadShot,\n\t\t\t\t\t\tEnum.ThumbnailSize.Size150x150\n\t\t\t\t\t)\n\t\t\t\tend)\n\t\t\t\tif ok then\n\t\t\t\t\tthumb.Image = image\n\t\t\t\tend\n\t\t\tend)\n\t\tend\n\t\tTheme.label({\n\t\t\tText = data.mvp.name,\n\t\t\tSize = UDim2.new(1, -30, 0, 36),\n\t\t\tPosition = UDim2.fromOffset(15, 214),\n\t\t\tTextColor3 = Theme.teamColor(data.mvp.team),\n\t\t\tFontFace = Theme.Fonts.Heavy,\n\t\t\tParent = mvpCard,\n\t\t})\n\t\tfor _, row in data.board or {} do\n\t\t\tif\n\t\t\t\t(data.mvp.botId and row.botId == data.mvp.botId)\n\t\t\t\tor (not data.mvp.botId and row.userId == data.mvp.userId)\n\t\t\tthen\n\t\t\t\tTheme.label({\n\t\t\t\t\tText = `{row.kills} elims  \u00b7  {row.doublePumps} double pumps`,\n\t\t\t\t\tSize = UDim2.new(1, -30, 0, 24),\n\t\t\t\t\tPosition = UDim2.fromOffset(15, 254),\n\t\t\t\t\tTextColor3 = C.TextDim,\n\t\t\t\t\tFontFace = Theme.Fonts.Bold,\n\t\t\t\t\tOutline = false,\n\t\t\t\t\tParent = mvpCard,\n\t\t\t\t})\n\t\t\tend\n\t\tend\n\telse\n\t\tTheme.label({\n\t\t\tText = \"\u2013\",\n\t\t\tSize = UDim2.new(1, 0, 0, 40),\n\t\t\tPosition = UDim2.fromOffset(0, 130),\n\t\t\tParent = mvpCard,\n\t\t})\n\tend\n\n\t-- Scoreboard table\n\tlocal tablePanel = Theme.panel({\n\t\tPosition = UDim2.fromOffset(530, 270),\n\t\tSize = UDim2.new(1, -1060, 0, 560),\n\t\tParent = resultsFrame,\n\t})\n\tlocal cols = {\n\t\t{ key = \"kills\", title = \"E\" },\n\t\t{ key = \"deaths\", title = \"D\" },\n\t\t{ key = \"assists\", title = \"A\" },\n\t\t{ key = \"headshots\", title = \"HS\" },\n\t\t{ key = \"doublePumps\", title = \"DP\" },\n\t\t{ key = \"damage\", title = \"DMG\" },\n\t\t{ key = \"accuracy\", title = \"ACC\" },\n\t\t{ key = \"score\", title = \"SCORE\" },\n\t}\n\tlocal colWidth = 74\n\tlocal head = new(\"Frame\", {\n\t\tSize = UDim2.new(1, -40, 0, 26),\n\t\tPosition = UDim2.fromOffset(20, 16),\n\t\tBackgroundTransparency = 1,\n\t\tParent = tablePanel,\n\t})\n\tfor i, col in cols do\n\t\tTheme.label({\n\t\t\tText = col.title,\n\t\t\tAnchorPoint = Vector2.new(1, 0),\n\t\t\tPosition = UDim2.new(1, -(#cols - i) * colWidth, 0, 0),\n\t\t\tSize = UDim2.new(0, colWidth, 1, 0),\n\t\t\tTextColor3 = C.TextDim,\n\t\t\tFontFace = Theme.Fonts.Bold,\n\t\t\tOutline = false,\n\t\t\tParent = head,\n\t\t})\n\tend\n\tlocal list = new(\"ScrollingFrame\", {\n\t\tSize = UDim2.new(1, -40, 1, -60),\n\t\tPosition = UDim2.fromOffset(20, 48),\n\t\tBackgroundTransparency = 1,\n\t\tBorderSizePixel = 0,\n\t\tScrollBarThickness = 4,\n\t\tAutomaticCanvasSize = Enum.AutomaticSize.Y,\n\t\tCanvasSize = UDim2.new(),\n\t\tParent = tablePanel,\n\t}, { Theme.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Left) })\n\tlocal board = table.clone(data.board or {})\n\ttable.sort(board, function(a: any, b: any)\n\t\tif a.team ~= b.team then\n\t\t\treturn (a.team or \"\") == (winner or \"Red\")\n\t\tend\n\t\treturn a.score > b.score\n\tend)\n\tfor i, row in board do\n\t\tlocal mine = row.userId == player.UserId\n\t\tlocal r = new(\"Frame\", {\n\t\t\tSize = UDim2.new(1, -8, 0, 44),\n\t\t\tBackgroundColor3 = Theme.teamColor(row.team),\n\t\t\tBackgroundTransparency = if mine then 0.45 else 0.8,\n\t\t\tLayoutOrder = i,\n\t\t\tParent = list,\n\t\t}, { Theme.corner(6) })\n\t\tTheme.label({\n\t\t\tText = row.name,\n\t\t\tSize = UDim2.new(1, -(#cols * colWidth) - 20, 0, 26),\n\t\t\tPosition = UDim2.fromOffset(12, 9),\n\t\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\t\tFontFace = Theme.Fonts.Bold,\n\t\t\tOutline = false,\n\t\t\tParent = r,\n\t\t})\n\t\tfor c, col in cols do\n\t\t\tlocal v = row[col.key] or 0\n\t\t\tlocal text = if col.key == \"accuracy\" then string.format(\"%d%%\", math.round(v * 100)) else tostring(v)\n\t\t\tTheme.label({\n\t\t\t\tText = text,\n\t\t\t\tAnchorPoint = Vector2.new(1, 0),\n\t\t\t\tPosition = UDim2.new(1, -(#cols - c) * colWidth, 0, 9),\n\t\t\t\tSize = UDim2.fromOffset(colWidth, 26),\n\t\t\t\tFontFace = if col.key == \"score\" then Theme.Fonts.Heavy else Theme.Fonts.Bold,\n\t\t\t\tOutline = false,\n\t\t\t\tParent = r,\n\t\t\t})\n\t\tend\n\tend\n\n\t-- Rewards (filled when the server sends them)\n\trewardPanel = Theme.panel({\n\t\tAnchorPoint = Vector2.new(1, 0),\n\t\tPosition = UDim2.new(1, -120, 0, 270),\n\t\tSize = UDim2.fromOffset(380, 300),\n\t\tParent = resultsFrame,\n\t})\n\tTheme.label({\n\t\tText = if data.training then \"TRAINING \u2014 NO REWARDS\" else \"REWARDS\",\n\t\tSize = UDim2.new(1, 0, 0, 46),\n\t\tPosition = UDim2.fromOffset(0, 18),\n\t\tFontFace = Theme.Fonts.Display,\n\t\tParent = rewardPanel,\n\t})\n\tTheme.label({\n\t\tName = \"Pending\",\n\t\tText = if data.training\n\t\t\tthen \"Training match: no permanent rewards or statistics\"\n\t\t\telseif myTeam then \"Calculating...\"\n\t\t\telse \"Play a match to earn XP\",\n\t\tSize = UDim2.new(1, -30, 0, 24),\n\t\tPosition = UDim2.fromOffset(15, 120),\n\t\tTextColor3 = C.TextDim,\n\t\tFontFace = Theme.Fonts.Bold,\n\t\tOutline = false,\n\t\tParent = rewardPanel,\n\t})\nend\n\nlocal function showReward(reward: any)\n\tif not rewardPanel or not rewardPanel.Parent then\n\t\treturn\n\tend\n\tlocal pending = rewardPanel:FindFirstChild(\"Pending\")\